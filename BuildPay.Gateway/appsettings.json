{
  "Keycloak": {
    "Authority": "http://keycloak:8080/realms/buildpay",
    "Audience": "buildpay-api"
  },
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://jaeger:4317",
  "DownstreamHealth": {
    "identity": "http://identity:8080/health",
    "marketplace": "http://marketplace:8080/health",
    "project": "http://project:8080/health",
    "payment": "http://payment:8080/health",
    "delivery": "http://delivery:8080/health",
    "notification": "http://notification:8080/health",
    "userprofile": "http://userprofile:8080/health"
  },
  "AdminOverview": {
    "users_total": "http://identity:8080/internal/stats/users",
    "verifications_pending": "http://identity:8080/internal/stats/verifications/pending",
    "products_total": "http://marketplace:8080/internal/stats/products",
    "orders_total": "http://marketplace:8080/internal/stats/orders",
    "projects_total": "http://project:8080/internal/stats/projects",
    "deliveries_total": "http://delivery:8080/internal/stats/deliveries"
  },
  "ReverseProxy": {
    "Routes": {
      "uploads_monolith": {
        "ClusterId": "monolith",
        "Order": 998,
        "Match": { "Path": "/uploads/{**catch-all}" },
        "AuthorizationPolicy": "Authenticated"
      },
      "fallback_monolith": {
        "ClusterId": "monolith",
        "Order": 999,
        "Match": { "Path": "/api/{**catch-all}" },
        "AuthorizationPolicy": "Authenticated"
      },
      "identity_auth": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "identity_users": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/users/{**catch-all}" },
        "AuthorizationPolicy": "Authenticated"
      },
      "identity_contractors": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/contractors/verifications/{**catch-all}" },
        "AuthorizationPolicy": "Authenticated"
      },
      "marketplace_products": {
        "ClusterId": "marketplace",
        "Match": { "Path": "/api/products/{**catch-all}" }
      },
      "marketplace_categories": {
        "ClusterId": "marketplace",
        "Match": { "Path": "/api/categories/{**catch-all}" }
      },
      "marketplace_cart": {
        "ClusterId": "marketplace",
        "Match": { "Path": "/api/cart/{**catch-all}" },
        "AuthorizationPolicy": "Authenticated"
      },
      "marketplace_orders": {
        "ClusterId": "marketplace",
        "Match": { "Path": "/api/orders/{**catch-all}" },
        "AuthorizationPolicy": "Authenticated"
      },
      "project_projects": {
        "ClusterId": "project",
        "Match": { "Path": "/api/projects/{**catch-all}" },
        "AuthorizationPolicy": "Authenticated"
      },
      "payment_payments": {
        "ClusterId": "payment",
        "Match": { "Path": "/api/payments/{**catch-all}" },
        "AuthorizationPolicy": "Authenticated"
      },
      "delivery_deliveries": {
        "ClusterId": "delivery",
        "Match": { "Path": "/api/deliveries/{**catch-all}" },
        "AuthorizationPolicy": "Authenticated"
      },
      "notification_notifications": {
        "ClusterId": "notification",
        "Match": { "Path": "/api/notifications/{**catch-all}" },
        "AuthorizationPolicy": "Authenticated"
      },
      "userprofile_profiles": {
        "ClusterId": "userprofile",
        "Match": { "Path": "/api/profiles/{**catch-all}" },
        "AuthorizationPolicy": "Authenticated"
      }
    },
    "Clusters": {
      "monolith": {
        "Destinations": { "d1": { "Address": "http://api:8081/" } }
      },
      "identity": {
        "Destinations": { "d1": { "Address": "http://identity:8080/" } }
      },
      "marketplace": {
        "Destinations": { "d1": { "Address": "http://marketplace:8080/" } }
      },
      "project": {
        "Destinations": { "d1": { "Address": "http://project:8080/" } }
      },
      "payment": {
        "Destinations": { "d1": { "Address": "http://payment:8080/" } }
      },
      "delivery": {
        "Destinations": { "d1": { "Address": "http://delivery:8080/" } }
      },
      "notification": {
        "Destinations": { "d1": { "Address": "http://notification:8080/" } }
      },
      "userprofile": {
        "Destinations": { "d1": { "Address": "http://userprofile:8080/" } }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
